# .env にコピーして使います: cp .env.example .env
# 値はクォートで囲まず、そのまま書いてください。

# 必須: ログイン用パスワード(12 文字以上)
ACCESS_PASSWORD=

# サーバーの待ち受け。外部公開は tailscale serve に任せるので 127.0.0.1 のままにしてください
PORT=3000
HOST=127.0.0.1

# wda: 実機 (WebDriverAgent) / mock: 実機なしで動作確認するためのモック端末
DRIVER=wda

# iproxy で転送した WebDriverAgent の API と MJPEG 配信の URL
WDA_URL=http://127.0.0.1:8100
# 空にすると MJPEG を使わず、スクリーンショットの定期取得(約 1 秒ごと)で表示します
WDA_MJPEG_URL=http://127.0.0.1:9100

# HTTPS(tailscale serve)経由で使う場合は true のまま。LAN 内で http 接続して試すときだけ false
COOKIE_SECURE=true

# --- scripts/start-mac.sh 用(任意) ---
# iPhone の UDID(idevice_id -l で確認)。複数台つないでいる場合に指定
IPHONE_UDID=
# 指定すると start-mac.sh が WebDriverAgent のビルド・起動も行います(絶対パスで指定)
WDA_PROJECT_DIR=

# --- Cloudflare Workers 経由で公開する場合(任意) ---
# Worker の ORIGIN_SECRET と同じ値(16 文字以上)。設定すると、このヘッダー付きの API 呼び出しを受け付けます
ORIGIN_SHARED_SECRET=
# 指定すると start-mac.sh が cloudflared tunnel run <名前> も起動します
CLOUDFLARE_TUNNEL_NAME=
